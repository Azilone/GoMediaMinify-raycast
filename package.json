{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "gomediaminify",
  "title": "GoMediaMinify",
  "description": "Run GoMediaMinify conversions from Raycast",
  "icon": "command-icon.png",
  "author": "Azilone",
  "categories": ["Productivity", "Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "convert-media",
      "title": "Convert Media",
